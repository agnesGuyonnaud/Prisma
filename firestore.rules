rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function conSesion() {
      return request.auth != null;
    }

    function esIntegrante(grupo) {
      return conSesion() &&
        request.auth.uid in get(/databases/$(database)/documents/grupos/$(grupo)).data.integrantes;
    }

    match /grupos/{grupo} {
      allow get: if conSesion();
      allow list: if conSesion() && request.auth.uid in resource.data.integrantes;
      allow create: if conSesion() &&
        request.resource.data.integrantes == [request.auth.uid];
      allow update: if conSesion() && (
        request.auth.uid in resource.data.integrantes ||
        (
          request.resource.data.integrantes.hasAll(resource.data.integrantes) &&
          request.resource.data.integrantes.removeAll(resource.data.integrantes) == [request.auth.uid] &&
          request.resource.data.nombre == resource.data.nombre
        )
      );
      allow delete: if false;

      match /tareas/{tarea} {
        allow read, write: if esIntegrante(grupo);

        match /archivos/{archivo}/partes/{parte} {
          allow read, delete: if esIntegrante(grupo);
          allow create: if esIntegrante(grupo) &&
            request.resource.data.keys().hasOnly(['datos']) &&
            request.resource.data.datos is bytes &&
            request.resource.data.datos.size() <= 700 * 1024;
        }
      }
    }
  }
}
